# GitHub Pages is static — Gemini runs in the browser.
# Create a key at https://aistudio.google.com/apikey and restrict by HTTP referrer
# (e.g. https://<user>.github.io/* and http://localhost:3000/*).

NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
NEXT_PUBLIC_LLM_MODEL=gemini-3.5-flash-lite

# Empty for local `next dev` at http://localhost:3000
# For Pages project site set to /gaze-adaptive-ui (CI sets this).
NEXT_PUBLIC_BASE_PATH=
